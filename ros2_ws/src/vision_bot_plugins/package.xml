<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_bot_plugins</name>
  <version>0.1.0</version>
  <description>
    RobotAvoidanceLayer: a Nav2 costmap layer that marks the other robots'
    shared poses, because a robot's 2D lidar cannot see another robot of
    this design (its chassis is below the scan plane).
  </description>
  <maintainer email="you@example.com">Zach</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>nav2_lifecycle_manager</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
