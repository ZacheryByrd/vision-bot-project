<?xml version="1.0"?>
<model>
  <name>person_photo_model</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    A real photograph of a person (cropped from a public street photo)
    textured onto a flat plane, used as the target for the DNN-based
    perception demo (dnn_follow_launch.py). Not a 3D person model --
    flat-shaded geometric primitives (box/sphere limbs) were tried first
    and got 0.0 confidence from a real-world-trained detector (MobileNet-SSD);
    a real photo texture gets ~0.8. See dnn_follow_launch.py's docstring.
  </description>
</model>
