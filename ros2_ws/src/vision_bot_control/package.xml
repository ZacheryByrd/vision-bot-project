<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_bot_control</name>
  <version>0.1.0</version>
  <description>
    motor_control_node in C++ (rclcpp): a drop-in replacement for
    vision_bot's Python motor_control_node, with the same node name, topics,
    parameters and control law. Pick it with control_impl:=cpp.
  </description>
  <maintainer email="you@example.com">Zach</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>nlohmann-json-dev</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
