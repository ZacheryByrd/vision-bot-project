<?xml version="1.0"?>
<sdf version="1.6">
  <world name="track_world">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- A single red box as the default vision target; matches the
         default HSV threshold (hue 0-10) in perception_node.py. Add
         more models here, or replace with a painted line on the ground
         plane, for the line-following variant. -->
    <model name="target_box">
      <static>true</static>
      <pose>1.0 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material>
            <ambient>0.8 0 0 1</ambient>
            <diffuse>0.8 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
        </collision>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
    </physics>
  </world>
</sdf>
